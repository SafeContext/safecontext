{
  "name": "@safecontext/agent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "prettier --check src && eslint src",
    "format": "prettier --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@huggingface/tokenizers": "^0.2.0",
    "@safecontext/detectors": "workspace:*",
    "@safecontext/policy": "workspace:*",
    "hono": "^4.13.13",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.12"
  }
}
