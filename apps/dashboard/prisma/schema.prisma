// Dashboard database. Prisma 7 (https://www.prisma.io/docs/v7). Contracts live in packages/policy;
// keep these models in step with `Policy`, `DataType`, `TermList` and `AgentEvent` there.
//
// Rules that can't be expressed in this file (CHECK constraints) are added by hand in the
// migration SQL: green <=> allow on DataType, id-shaped keys, non-negative counts.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums. Values match the Zod enums in packages/policy exactly.
// ---------------------------------------------------------------------------

/// Traffic-light column a data type sits in.
enum Tier {
  green
  yellow
  red
}

/// What the agent does to a span of a data type.
enum Action {
  allow
  generalize
  pseudonymize
  mask
  block
}

/// What the agent does when it can't finish checking (SPEC.md §2a).
enum FailMode {
  block
  allow
}

/// What a dashboard admin may do (issue #23). Admins change and publish the policy; viewers see
/// every page but change nothing.
enum MemberRole {
  admin
  viewer
}

enum HookEventName {
  UserPromptSubmit
  PreToolUse
  PostToolUse
}

// ---------------------------------------------------------------------------
// Organisation, people, policy
// ---------------------------------------------------------------------------

model Organization {
  id                     String    @id @default(uuid(7)) @db.Uuid
  name                   String
  slug                   String    @unique
  /// Draft setting. Copied into each PolicyVersion when published.
  failMode               FailMode  @default(block)
  /// Draft setting: tools whose input gets real values put back in place of placeholders
  /// (`Policy.swapBack.tools`, issue #83). Defaults to `LOCAL_SWAP_BACK_TOOLS`; keep them in step.
  /// Copied into each PolicyVersion when published.
  swapBackTools          String[]  @default(["Read", "Write", "Edit", "MultiEdit", "NotebookEdit", "Glob", "Grep"])
  /// SHA-256 (hex) of the enrollment key a device presents to `POST /api/devices` to join this
  /// organisation. The key itself is never stored. Null = devices can't register.
  enrollmentKeyHash      String?   @unique @db.Char(64)
  enrollmentKeyCreatedAt DateTime? @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  members        Member[]
  dataTypes      DataType[]
  policyVersions PolicyVersion[]
  devices        Device[]
  events         Event[]
}

/// A person who can sign in to one organisation's dashboard (`role` says whether they can change
/// the policy). Signing in to the dashboard (issue #19) needs a Member row: it
/// decides which organisation's data the admin sees (`src/lib/server/current-org.ts`).
///
/// `userId` links the sign-in account (`User`). It is filled in at first sign-in by matching
/// `email` (`src/lib/server/auth.ts`), so a Member can be added before its account exists.
model Member {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @db.Uuid
  email          String
  name           String?
  role           MemberRole @default(admin)
  /// Better Auth `user.id`. Null until the person first signs in. Unique: one user, one member.
  userId         String?    @unique
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  published    PolicyVersion[]

  @@unique([organizationId, email])
}

// ---------------------------------------------------------------------------
// Sign-in (Better Auth, issue #19). Fields follow Better Auth's core schema
// (https://www.better-auth.com/docs/concepts/database#core-schema); Better Auth reads and writes
// these tables itself, so don't rename fields. Ids are Better Auth's own strings, not uuids.
// ---------------------------------------------------------------------------

/// A person who can sign in. Their organisation comes from `Member`.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
  member   Member?
}

/// A signed-in browser. `token` is what the session cookie carries.
model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// How a user signs in. Email + password is `providerId = "credential"`, with the password hash
/// in `password`. The token columns are for sign-in providers we don't use yet (Google, SSO).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived codes (e.g. password reset). Unused by email + password sign-in today.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// The editable (draft) data types. Moving a card between columns on the dashboard changes
/// `tier` and `action`. Publishing copies the current rows into a PolicyVersion snapshot.
model DataType {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// Policy id, e.g. "customer-names". Also the key events count against.
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(80)
  description    String   @db.VarChar(500)
  examples       String[]
  tier           Tier
  action         Action
  /// Order within its column.
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  termList     TermList?

  @@unique([organizationId, key])
  @@index([organizationId, tier, position])
}

/// Exact-match terms an admin uploads for one data type (codenames, customer names).
model TermList {
  id         String   @id @default(uuid(7)) @db.Uuid
  dataTypeId String   @unique @db.Uuid
  terms      String[]
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  dataType DataType @relation(fields: [dataTypeId], references: [id], onDelete: Cascade)
}

/// An immutable published policy. `snapshot` is a complete `Policy` (packages/policy), which is
/// exactly what the agent pulls. Versions start at 1; 0 means "never published" in the contract.
model PolicyVersion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  version        Int
  failMode       FailMode
  snapshot       Json
  publishedAt    DateTime @default(now()) @db.Timestamptz(3)
  publishedById  String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedBy  Member?      @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, version])
}

// ---------------------------------------------------------------------------
// Devices and events. METADATA ONLY: ids, names of tools, numbers and timestamps.
// No column here may ever hold prompt, file or tool text (SPEC.md §3).
// ---------------------------------------------------------------------------

model Device {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @db.Uuid
  /// The agent's anonymised device id (`AgentEvent.deviceId`).
  deviceId          String    @db.VarChar(64)
  firstSeenAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  /// Policy version from the device's latest event; shows whether it has picked up a publish.
  lastPolicyVersion Int?
  /// SHA-256 (hex) of the device's API token (the token itself is never stored). Null = no token
  /// (e.g. seeded demo devices) or revoked. Registering again replaces it.
  tokenHash         String?   @unique @db.Char(64)
  tokenIssuedAt     DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([organizationId, deviceId])
  // Lets Event point at (organisation, device) together so an event can't name another org's device.
  @@unique([organizationId, id])
}

/// One check the agent made (`AgentEvent`). Counts are typed columns plus `EventCount` rows;
/// there is deliberately no Json or free-text column.
model Event {
  id                 String        @id @default(uuid(7)) @db.Uuid
  organizationId     String        @db.Uuid
  deviceId           String        @db.Uuid
  /// When the agent made the check (`AgentEvent.ts`).
  ts                 DateTime      @db.Timestamptz(3)
  receivedAt         DateTime      @default(now()) @db.Timestamptz(3)
  policyVersion      Int
  hookEvent          HookEventName
  /// Claude Code tool name, e.g. "Read" or "mcp__slack__post". Null for UserPromptSubmit.
  toolName           String?       @db.VarChar(128)
  blocked            Boolean
  latencyMs          Float
  /// Spans handled, per action (`AgentEvent.actions`).
  actionAllow        Int           @default(0)
  actionGeneralize   Int           @default(0)
  actionPseudonymize Int           @default(0)
  actionMask         Int           @default(0)
  actionBlock        Int           @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Cascade)
  counts       EventCount[]

  @@index([organizationId, ts(sort: Desc)])
  @@index([deviceId, ts(sort: Desc)])
}

/// Spans found in one event for one data type (`AgentEvent.counts`).
/// `dataTypeKey` is not a foreign key on purpose: events are history and must outlive data types.
model EventCount {
  eventId     String @db.Uuid
  dataTypeKey String @db.VarChar(64)
  count       Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, dataTypeKey])
  @@index([dataTypeKey])
}
