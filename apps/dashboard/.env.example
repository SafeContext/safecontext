# Copy to `.env`. Local Postgres 18 (Homebrew) database for the dashboard.
DATABASE_URL="postgresql://USER@localhost:5432/safecontext"

# Signs admin sign-in cookies (Better Auth). Required: at least 32 random characters.
# Generate one with: openssl rand -base64 32   (changing it signs every admin out)
BETTER_AUTH_SECRET=""

# The dashboard's public URL. Leave unset locally; set it when deployed.
# BETTER_AUTH_URL="https://safecontext.example.com"
