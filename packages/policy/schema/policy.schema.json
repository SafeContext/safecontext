{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "dataTypes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "examples": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "tier": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "allow",
              "generalize",
              "pseudonymize",
              "mask",
              "block"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "tier",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "lists": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataTypeId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "dataTypeId",
          "terms"
        ],
        "additionalProperties": false
      }
    },
    "failMode": {
      "default": "block",
      "type": "string",
      "enum": [
        "block",
        "allow"
      ]
    }
  },
  "required": [
    "version",
    "updatedAt",
    "dataTypes"
  ],
  "additionalProperties": false
}
