#!/bin/sh
# Posts a message to #deploys when a release goes out.
# TODO(orders-398): read the webhook from SLACK_WEBHOOK_URL instead of hard-coding it here.
set -e
VERSION="${1:?usage: notify-deploy.sh <version>}"
WEBHOOK="__FAKE_SLACK_WEBHOOK__"

curl -sS -X POST "$WEBHOOK" \
  -H 'content-type: application/json' \
  -d "{\"text\": \"orders-api $VERSION is live on production\"}"
